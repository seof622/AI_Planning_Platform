# Leave empty to report unknown cost rather than inventing a price.
PLANNING_MODEL_RATES_JSON={}

POSTGRES_DB=ai_planning_platform
POSTGRES_USER=ai_planning
POSTGRES_PASSWORD=ai_planning_local
POSTGRES_PORT=5432
