{
  "name": "ai-planning-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:typecheck": "npm run typecheck -w apps/web",
    "web:test": "npm run test -w apps/web",
    "evaluate:planning": "node scripts/runPlanningEvaluation.mjs",
    "evaluate:planning:check": "node scripts/runPlanningEvaluation.mjs --dry-run",
    "evaluate:planning:test": "node --test tests/evaluation/*.test.mjs",
    "shared:typecheck": "npm run typecheck -w packages/shared",
    "shared:validate:mock": "npm run validate:mock -w packages/shared"
  }
}
